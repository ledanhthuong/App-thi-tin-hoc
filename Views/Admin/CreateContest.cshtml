@using App_thi_tin_hoc.Models
@model Contest
@{
    ViewData["Title"] = "Tạo Kỳ Thi Mới";
}

<div class="row">
    <div class="col-lg-7 mx-auto">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-primary mb-0"><i class="fa-solid fa-folder-plus"></i> Tạo Kỳ Thi Mới</h2>
            <a asp-action="Contests" class="btn-kids btn-secondary-kids">
                <i class="fa-solid fa-arrow-left"></i> Quay lại
            </a>
        </div>

        <div class="card-kids p-4">
            <form asp-action="CreateContest" method="post" class="form-kids">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Tên kỳ thi</label>
                    <input asp-for="Title" class="form-control" placeholder="Ví dụ: Hội thi Tin học trẻ - Khối lớp 5" required />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Mô tả kỳ thi</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Nhập một vài lời giới thiệu, thể lệ cuộc thi dành cho các em học sinh..." required></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6 mb-3">
                        <label asp-for="StartTime" class="form-label">Thời gian bắt đầu</label>
                        <input asp-for="StartTime" class="form-control" type="datetime-local" required />
                        <span asp-validation-for="StartTime" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="EndTime" class="form-label">Thời gian kết thúc</label>
                        <input asp-for="EndTime" class="form-control" type="datetime-local" required />
                        <span asp-validation-for="EndTime" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-check form-switch mb-4 fs-5">
                    <input asp-for="ShowCodeHints" class="form-check-input" type="checkbox" id="ShowCodeHints" checked />
                    <label class="form-check-label fw-bold text-primary" for="ShowCodeHints">
                        💡 Cho phép học sinh xem Mẫu Code gợi ý đọc dữ liệu
                    </label>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn-kids btn-primary-kids py-3 wiggle-hover">
                        <i class="fa-solid fa-cloud-arrow-up"></i> Lưu Kỳ Thi Lên Máy Chủ 🚀
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
