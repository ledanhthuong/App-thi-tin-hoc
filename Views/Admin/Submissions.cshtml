@using App_thi_tin_hoc.Models
@model List<Submission>
@{
    var contests = ViewBag.Contests as List<Contest> ?? new List<Contest>();
    var sessions = ViewBag.Sessions as List<string> ?? new List<string>();
    var selectedContestId = ViewBag.SelectedContestId as int?;
    var selectedSession = ViewBag.SelectedSession as string ?? "";
    var searchStudent = ViewBag.SearchStudent as string ?? "";
    var selectedStatus = ViewBag.SelectedStatus as string ?? "";
    ViewData["Title"] = "Lịch Sử Bài Làm Hệ Thống";
}

<div class="row">
    <div class="col-lg-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-primary mb-0"><i class="fa-solid fa-clock-rotate-left"></i> Lịch Sử Bài Làm Học Sinh</h2>
            <a asp-action="Index" class="btn-kids btn-secondary-kids">
                <i class="fa-solid fa-arrow-left"></i> Bảng Quản Trị
            </a>
        </div>

        <!-- Filter Card -->
        <div class="card-kids p-4 mb-4">
            <h4 class="text-primary mt-0 mb-3"><i class="fa-solid fa-magnifying-glass"></i> Bộ lọc tìm kiếm</h4>
            <form asp-action="Submissions" method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">Kỳ thi:</label>
                    <select name="contestId" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Tất cả kỳ thi --</option>
                        @foreach (var c in contests)
                        {
                            if (c.Id == selectedContestId)
                            {
                                <option value="@c.Id" selected>@c.Title</option>
                            }
                            else
                            {
                                <option value="@c.Id">@c.Title</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">Đợt thi (Session Group):</label>
                    <select name="session" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Tất cả đợt thi --</option>
                        @foreach (var s in sessions)
                        {
                            if (s == selectedSession)
                            {
                                <option value="@s" selected>@s</option>
                            }
                            else
                            {
                                <option value="@s">@s</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">Tìm học sinh (Họ tên/Username):</label>
                    <input type="text" name="searchStudent" class="form-control" placeholder="Nhập tên..." value="@searchStudent" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold small text-muted">Trạng thái:</label>
                    <select name="statusFilter" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Tất cả --</option>
                        <option value="Accepted" selected="@(selectedStatus == "Accepted")">Chính xác (AC)</option>
                        <option value="Wrong Answer" selected="@(selectedStatus == "Wrong Answer")">Chưa đúng (WA)</option>
                        <option value="Submitted" selected="@(selectedStatus == "Submitted")">Chờ GV chấm</option>
                        <option value="Pending" selected="@(selectedStatus == "Pending")">Đang chờ</option>
                        <option value="Judging" selected="@(selectedStatus == "Judging")">Đang chấm</option>
                        <option value="Compile Error" selected="@(selectedStatus == "Compile Error")">Lỗi biên dịch</option>
                    </select>
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100 p-2" style="border-radius: var(--border-radius-md);"><i class="fa-solid fa-search"></i> Lọc</button>
                </div>
            </form>
        </div>

        <!-- Results Table -->
        <div class="card-kids p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="text-primary my-0"><i class="fa-solid fa-list"></i> Danh sách bài nộp</h3>
                <span class="badge bg-secondary p-2 fs-6">Tìm thấy: <strong>@Model.Count</strong> bài nộp</span>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <p class="text-muted fs-5">Không có bài nộp nào phù hợp với bộ lọc tìm kiếm.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr class="table-light">
                                <th>Học sinh</th>
                                <th>Kỳ thi</th>
                                <th>Đợt thi</th>
                                <th>Đề bài</th>
                                <th>Ngôn ngữ</th>
                                <th>Nộp lúc</th>
                                <th>Trạng thái</th>
                                <th>Điểm số</th>
                                <th class="text-end">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sub in Model)
                            {
                                var statusClass = sub.Status switch
                                {
                                    "Accepted" => "status-ac",
                                    "Wrong Answer" => "status-wa",
                                    "Pending" => "status-pending",
                                    "Judging" => "status-judging",
                                    "Compile Error" => "status-ce",
                                    _ => "status-pending"
                                };

                                var statusText = sub.Status switch
                                {
                                    "Accepted" => "Chính xác ✅",
                                    "Wrong Answer" => "Chưa đúng ❌",
                                    "Pending" => "Đang chờ ⏳",
                                    "Judging" => "Đang chấm... 🤖",
                                    "Compile Error" => "Lỗi biên dịch 📝",
                                    "Submitted" => "Chờ GV chấm 📑",
                                    _ => sub.Status
                                };

                                <tr>
                                    <td>
                                        <strong>@sub.Account?.FullName</strong><br />
                                        <small class="text-muted">@sub.Account?.Username</small>
                                    </td>
                                    <td>@sub.Contest?.Title</td>
                                    <td><span class="badge bg-light text-muted border">@sub.SessionGroup</span></td>
                                    <td>@sub.Problem?.Title</td>
                                    <td><span class="badge bg-light text-dark border">@sub.Language</span></td>
                                    <td>@sub.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                                    <td><span class="status-badge @statusClass">@statusText</span></td>
                                    <td><strong class="text-primary fs-5">@sub.Score</strong> / @sub.Problem?.Points</td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-1">
                                            <a asp-controller="Contest" asp-action="SubmissionDetail" asp-route-id="@sub.Id" class="btn btn-sm btn-outline-info" style="font-size: 0.85rem;">
                                                <i class="fa-solid fa-code"></i> Xem code
                                            </a>
                                            @if (sub.Language == "Scratch" && sub.Status == "Submitted")
                                            {
                                                <a asp-action="GradeScratch" asp-route-submissionId="@sub.Id" class="btn btn-sm btn-warning" style="font-size: 0.85rem;">
                                                    <i class="fa-solid fa-pen-to-square"></i> Chấm bài
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
