@using App_thi_tin_hoc.Models
@{
    ViewData["Title"] = "Tạo Nhanh Tài Khoản";
    var createdAccounts = ViewBag.CreatedAccounts as List<Account> ?? new List<Account>();
}

<div class="row">
    <div class="col-lg-10 mx-auto">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-primary mb-0"><i class="fa-solid fa-users-gear"></i> Tạo Nhanh Tài Khoản Theo Lớp Học</h2>
            <a asp-action="Index" class="btn-kids btn-secondary-kids">
                <i class="fa-solid fa-arrow-left"></i> Bảng Quản Trị
            </a>
        </div>

        <div class="row">
            <!-- Account Generation Form -->
            <div class="col-md-5 mb-4">
                <div class="card-kids p-4 h-100">
                    <h3 class="text-primary mt-0 mb-3"><i class="fa-solid fa-square-plus"></i> Khởi tạo Lớp</h3>
                    
                    <form asp-action="GenerateAccounts" method="post" class="form-kids">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label for="className" class="form-label">Tên lớp học (Ví dụ: 5A, 4B)</label>
                            <input type="text" class="form-control" id="className" name="className" placeholder="Nhập ký hiệu lớp" required />
                            <small class="text-muted">Hệ thống sẽ tạo username như: <code>lop5a_01</code>, <code>lop5a_02</code>...</small>
                        </div>

                        <div class="mb-4">
                            <label for="quantity" class="form-label">Số lượng học sinh trong lớp</label>
                            <input type="number" class="form-control" id="quantity" name="quantity" value="10" min="1" max="50" required />
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn-kids btn-primary-kids py-3 wiggle-hover">
                                <i class="fa-solid fa-gears"></i> Bấm Để Tạo Tài Khoản 🚀
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Created Accounts Display -->
            <div class="col-md-7 mb-4">
                <div class="card-kids p-4 h-100">
                    <h3 class="text-primary mt-0 mb-3"><i class="fa-solid fa-id-card-clip"></i> Danh Sách Tài Khoản Đã Tạo</h3>
                    
                    @if (!createdAccounts.Any())
                    {
                        <div class="text-center py-5 bg-light rounded" style="border: 2px dashed hsl(220, 30%, 85%);">
                            <span style="font-size: 3rem;" class="text-muted d-block mb-3">📇</span>
                            <p class="text-muted">Nhập thông tin bên trái để tạo tài khoản in phát cho học sinh.</p>
                        </div>
                    }
                    else
                    {

                        <div class="d-flex justify-content-end mb-2">
                            <button onclick="window.print()" class="btn btn-sm btn-outline-dark">
                                <i class="fa-solid fa-print"></i> In danh sách này
                            </button>
                        </div>

                        <div style="max-height: 400px; overflow-y: auto;" class="border rounded p-2 bg-light print-scroll-reset">
                            <div class="row g-2">
                                @foreach (var acc in createdAccounts)
                                {
                                    <div class="col-sm-6 print-slip-col">
                                        <div class="bg-white p-3 rounded shadow-sm border border-secondary print-slip" style="font-size: 0.9rem;">
                                            <div class="fw-bold text-primary mb-1 print-text-primary">@acc.FullName</div>
                                            <div>Tên đăng nhập: <code class="fw-bold text-dark text-black">@acc.Username</code></div>
                                            <div>Mật khẩu: <code class="text-black font-monospace">@(string.IsNullOrEmpty(acc.PlainTextPassword) ? "123456" : acc.PlainTextPassword)</code></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
