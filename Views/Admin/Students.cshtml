@model List<App_thi_tin_hoc.Models.Account>
@{
    ViewData["Title"] = "Quản Lý Tài Khoản Học Sinh";
}

<div class="row">
    <div class="col-lg-12">
        <div class="banner-kids p-4 mb-4" style="background: linear-gradient(135deg, hsl(200, 90%, 25%), hsl(200, 60%, 40%));">
            <h1 class="text-white mb-2">Quản Lý Học Sinh 🧑‍🎓</h1>
            <p class="text-white-50">Xem danh sách, tìm kiếm, sửa đổi thông tin điểm số, đặt lại mật khẩu hoặc xóa tài khoản của học sinh tại đây.</p>
            
            <div class="d-flex flex-wrap gap-2 mt-3">
                <a asp-action="Index" class="btn-kids btn-secondary-kids">
                    <i class="fa-solid fa-arrow-left"></i> Quay lại Dashboard
                </a>
                <a asp-action="CreateStudent" class="btn-kids btn-primary-kids">
                    <i class="fa-solid fa-user-plus"></i> Thêm Học Sinh Mới
                </a>
                <a asp-action="GenerateAccounts" class="btn-kids btn-accent-kids">
                    <i class="fa-solid fa-users-gear"></i> Tạo Nhanh Hàng Loạt (Lớp)
                </a>
                @if (ViewBag.IsSuperAdmin == true)
                {
                    <button type="button" class="btn-kids btn-danger-kids" onclick="confirmDeleteAll()">
                        <i class="fa-solid fa-users-slash"></i> Xóa Sạch Học Sinh
                    </button>
                }
                else
                {
                    <button type="button" class="btn-kids btn-danger-kids" onclick="confirmDeleteMyCreated()">
                        <i class="fa-solid fa-users-slash"></i> Xóa Học Sinh Đã Tạo
                    </button>
                }
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-kids alert-success-kids alert-dismissible fade show" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Search and Filter Card -->
        <div class="card-kids p-4 mb-4">
            <form method="get" asp-action="Students" class="row align-items-center g-3">
                <div class="col-md-9">
                    <div class="form-kids">
                        <label for="search" class="visually-hidden">Tìm kiếm học sinh</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-3 border-end-0" style="border-radius: var(--border-radius-md) 0 0 var(--border-radius-md); border-color: hsl(220, 30%, 90%);">
                                <i class="fa-solid fa-magnifying-glass text-muted"></i>
                            </span>
                            <input type="text" id="search" name="search" class="form-control border-3 border-start-0" placeholder="Nhập tên đăng nhập hoặc họ và tên để tìm kiếm..." value="@ViewBag.SearchTerm" style="border-radius: 0 var(--border-radius-md) var(--border-radius-md) 0; border-color: hsl(220, 30%, 90%);" />
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn-kids btn-primary-kids w-100 m-0">
                            <i class="fa-solid fa-filter"></i> Tìm Kiếm
                        </button>
                        @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
                        {
                            <a asp-action="Students" class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center" style="border-radius: var(--border-radius-md); padding: 0 16px;">
                                <i class="fa-solid fa-xmark"></i>
                            </a>
                        }
                    </div>
                </div>
            </form>
        </div>

        <!-- Student List Card -->
        <div class="card-kids p-4">
            <h3 class="text-primary mt-0 mb-4"><i class="fa-solid fa-users"></i> Danh Sách Học Sinh (@Model.Count)</h3>
            
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <img src="/images/avatars/default.png" alt="Empty" style="width: 100px; opacity: 0.5; margin-bottom: 16px;" />
                    <p class="text-muted fs-5">Không tìm thấy tài khoản học sinh nào phù hợp!</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr class="table-light">
                                <th style="width: 80px;">Ảnh đại diện</th>
                                <th>Tên đăng nhập</th>
                                <th>Họ và tên</th>
                                <th>Danh hiệu</th>
                                <th>Điểm tích lũy</th>
                                <th>Ngày tạo</th>
                                <th style="width: 200px;" class="text-end">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model)
                            {
                                <tr>
                                    <td>
                                        <img src="@(string.IsNullOrEmpty(student.AvatarUrl) ? "/images/avatars/default.png" : student.AvatarUrl)" alt="Avatar" class="avatar-pill" style="width: 48px; height: 48px; border-radius: 50%; border: 2px solid var(--color-primary); padding: 2px; background: #fff;" />
                                    </td>
                                    <td><strong class="text-primary fs-5">@student.Username</strong></td>
                                    <td><strong>@student.FullName</strong></td>
                                    <td>
                                        <span class="badge bg-light text-dark border border-secondary px-3 py-2 fw-bold" style="border-radius: 50px;">
                                            @student.RankTitle
                                        </span>
                                    </td>
                                    <td>
                                        <span class="fs-5 fw-bold text-success">@student.Points</span> <span class="small text-muted">điểm</span>
                                    </td>
                                    <td>@student.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <div class="d-flex justify-content-end gap-1">
                                            @if (ViewBag.IsSuperAdmin == true || student.CreatedById == ViewBag.CurrentUserId)
                                            {
                                                <a asp-action="EditStudent" asp-route-id="@student.Id" class="btn btn-sm btn-outline-primary" style="font-size: 0.9rem; border-radius: 8px;">
                                                    <i class="fa-solid fa-user-pen"></i> Sửa
                                                </a>
                                                <a href="javascript:void(0);" onclick="confirmDelete(@student.Id, '@student.Username')" class="btn btn-sm btn-outline-danger" style="font-size: 0.9rem; border-radius: 8px;">
                                                    <i class="fa-solid fa-trash-can"></i> Xóa
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small"><i class="fa-solid fa-lock"></i> Đọc duy nhất</span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: var(--border-radius-lg); border: 3px solid var(--color-danger); overflow: hidden;">
            <div class="modal-header bg-danger text-white border-0 py-3">
                <h5 class="modal-title fw-bold" id="deleteConfirmModalLabel"><i class="fa-solid fa-triangle-exclamation"></i> Cảnh Báo Xóa Tài Khoản!</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="fs-5 mb-2">Bạn có chắc chắn muốn xóa tài khoản <strong id="deleteStudentUsername" class="text-danger"></strong>?</p>
                <div class="alert alert-warning-kids p-3 mb-0" style="background-color: hsl(45, 95%, 95%); border: 2px solid hsl(45, 95%, 85%); border-radius: var(--border-radius-md);">
                    <i class="fa-solid fa-circle-exclamation text-warning me-2"></i>
                    <strong>Chú ý:</strong> Hành động này sẽ xóa vĩnh viễn tài khoản cùng tất cả lịch sử nộp bài (submissions) liên quan! Không thể khôi phục lại.
                </div>
            </div>
            <div class="modal-footer border-0 p-3 bg-light d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" style="border-radius: var(--border-radius-md); padding: 8px 20px;">Hủy bỏ</button>
                <a id="deleteConfirmBtn" href="#" class="btn btn-danger" style="border-radius: var(--border-radius-md); padding: 8px 24px; font-weight: bold;">Đồng ý Xóa</a>
            </div>
        </div>
    </div>
</div>

<!-- Delete All Confirmation Modal -->
<div class="modal fade" id="deleteAllConfirmModal" tabindex="-1" aria-labelledby="deleteAllConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: var(--border-radius-lg); border: 4px solid var(--color-danger); overflow: hidden; box-shadow: var(--shadow-lg);">
            <div class="modal-header bg-danger text-white border-0 py-3">
                <h5 class="modal-title fw-bold" id="deleteAllConfirmModalLabel"><i class="fa-solid fa-users-slash text-white me-2"></i> NGUY HIỂM: XÓA SẠCH HỌC SINH!</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="fs-5 mb-2 text-danger fw-bold">BẠN CÓ CHẮC CHẮN MUỐN XÓA TOÀN BỘ HỌC SINH TRÊN HỆ THỐNG?</p>
                <p class="text-muted">Hành động này được thực hiện trước khi bắt đầu một kỳ thi mới. Khi đồng ý:</p>
                <ul class="text-muted small">
                    <li>Tất cả tài khoản học sinh (Role = Student) sẽ bị xóa sạch hoàn toàn.</li>
                    <li>Mọi bài giải, điểm số và lịch sử chấm điểm (Submissions) của học sinh sẽ biến mất vĩnh viễn.</li>
                    <li>Chỉ giữ lại tài khoản của Giáo viên (Teacher) và Quản trị viên (Admin/Superadmin).</li>
                </ul>
                <div class="alert alert-danger-kids p-3 mb-0">
                    <i class="fa-solid fa-triangle-exclamation text-danger me-2"></i>
                    <strong>Cảnh báo cực kỳ quan trọng:</strong> Dữ liệu đã xóa KHÔNG thể khôi phục! Hãy chắc chắn Thầy/Cô đã sao lưu hoặc ghi lại kết quả của đợt thi trước nếu cần.
                </div>
            </div>
            <div class="modal-footer border-0 p-3 bg-light d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" style="border-radius: var(--border-radius-md); padding: 8px 20px;">Hủy bỏ</button>
                <a asp-action="DeleteAllStudents" class="btn btn-danger" style="border-radius: var(--border-radius-md); padding: 8px 24px; font-weight: bold;">Tôi đã hiểu, XÓA HẾT HỌC SINH</a>
            </div>
        </div>
    </div>
</div>
<!-- Delete My Created Confirmation Modal -->
<div class="modal fade" id="deleteMyCreatedConfirmModal" tabindex="-1" aria-labelledby="deleteMyCreatedConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: var(--border-radius-lg); border: 4px solid var(--color-danger); overflow: hidden; box-shadow: var(--shadow-lg);">
            <div class="modal-header bg-danger text-white border-0 py-3">
                <h5 class="modal-title fw-bold" id="deleteMyCreatedConfirmModalLabel"><i class="fa-solid fa-users-slash text-white me-2"></i> XÁC NHẬN: XÓA HỌC SINH ĐÃ TẠO!</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="fs-5 mb-2 text-danger fw-bold">Bạn có chắc chắn muốn xóa TOÀN BỘ học sinh do Thầy/Cô tự tạo?</p>
                <p class="text-muted">Khi đồng ý:</p>
                <ul class="text-muted small">
                    <li>Tất cả tài khoản học sinh do Thầy/Cô tạo sẽ bị xóa vĩnh viễn khỏi hệ thống.</li>
                    <li>Mọi bài giải và lịch sử chấm điểm (Submissions) của các học sinh này sẽ bị xóa.</li>
                    <li>Tài khoản do các giáo viên khác hoặc superadmin tạo sẽ được giữ nguyên.</li>
                </ul>
                <div class="alert alert-danger-kids p-3 mb-0">
                    <i class="fa-solid fa-triangle-exclamation text-danger me-2"></i>
                    <strong>Chú ý:</strong> Dữ liệu đã xóa KHÔNG thể khôi phục! Hãy chắc chắn Thầy/Cô muốn thực hiện hành động này.
                </div>
            </div>
            <div class="modal-footer border-0 p-3 bg-light d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" style="border-radius: var(--border-radius-md); padding: 8px 20px;">Hủy bỏ</button>
                <a asp-action="DeleteMyStudents" class="btn btn-danger" style="border-radius: var(--border-radius-md); padding: 8px 24px; font-weight: bold;">Đồng ý Xóa</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, username) {
            document.getElementById('deleteStudentUsername').textContent = username;
            document.getElementById('deleteConfirmBtn').href = '/Admin/DeleteStudent/' + id;
            var myModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
            myModal.show();
        }
        function confirmDeleteAll() {
            var myModal = new bootstrap.Modal(document.getElementById('deleteAllConfirmModal'));
            myModal.show();
        }
        function confirmDeleteMyCreated() {
            var myModal = new bootstrap.Modal(document.getElementById('deleteMyCreatedConfirmModal'));
            myModal.show();
        }
    </script>
}
