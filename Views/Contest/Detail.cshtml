@using App_thi_tin_hoc.Models
@using App_thi_tin_hoc.Controllers
@model Contest
@{
    ViewData["Title"] = Model.Title;
    var bestSubs = ViewBag.UserBestSubmissions as Dictionary<int, UserSubmissionSummary> ?? new Dictionary<int, UserSubmissionSummary>();
}

<div class="row">
    <!-- Main Left Column -->
    <div class="col-lg-9 mx-auto">
        <!-- Contest Header Card -->
        <div class="card-kids p-4 mb-4" style="background: linear-gradient(135deg, hsl(252, 90%, 97%), hsl(200, 95%, 97%)); border-color: var(--color-primary);">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <a asp-controller="Home" asp-action="Index" class="btn-kids btn-secondary-kids" style="padding: 6px 16px; font-size: 0.95rem;">
                    <i class="fa-solid fa-arrow-left"></i> Quay lại Trang Chủ
                </a>
                @if (DateTime.UtcNow > Model.EndTime)
                {
                    <span class="badge bg-danger p-2 fs-6 rounded-pill"><i class="fa-solid fa-circle-xmark"></i> Cuộc thi Đã kết thúc</span>
                }
                else
                {
                    <span class="badge bg-success p-2 fs-6 rounded-pill"><i class="fa-solid fa-circle-play"></i> Cuộc thi Đang mở</span>
                }
            </div>
            <h1 class="text-primary mt-2">@Model.Title</h1>
            <p class="text-muted fs-5">@Model.Description</p>
            
            <hr class="my-3" style="border-top: 2px dashed hsl(252, 30%, 80%);" />
            
            <!-- Contest secondary navigation -->
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Submissions" asp-route-contestId="@Model.Id" class="btn-kids btn-primary-kids">
                    <i class="fa-solid fa-list-check"></i> Lịch Sử Nộp Bài
                </a>
                <a asp-action="Leaderboard" asp-route-contestId="@Model.Id" class="btn-kids btn-accent-kids">
                    <i class="fa-solid fa-ranking-star"></i> Bảng Xếp Hạng Kỳ Thi
                </a>
            </div>
        </div>

        <h2 class="mb-4 text-center"><i class="fa-solid fa-flag-checkered text-primary"></i> Hành Trình Chinh Phục Thử Thách</h2>
        
        <div class="row">
            @{
                int questNum = 1;
                @foreach (var problem in Model.Problems)
                {
                    bool hasSub = bestSubs.ContainsKey(problem.Id);
                    var score = hasSub ? bestSubs[problem.Id].MaxScore : 0;
                    var status = hasSub ? bestSubs[problem.Id].Status : "Unsolved";

                    <div class="col-md-6 mb-4">
                        <div class="card-kids h-100 d-flex flex-column">
                            <div class="card-header-kids d-flex justify-content-between align-items-center">
                                <span class="badge bg-primary fs-6">Nhiệm vụ @questNum</span>
                                @if (status == "Accepted")
                                {
                                    <span class="status-badge status-ac"><i class="fa-solid fa-circle-check"></i> Đã hoàn thành</span>
                                }
                                else if (status == "Wrong Answer")
                                {
                                    <span class="status-badge status-wa"><i class="fa-solid fa-circle-xmark"></i> Sai kết quả</span>
                                }
                                else if (status == "Submitted")
                                {
                                    <span class="status-badge status-pending"><i class="fa-solid fa-clock"></i> Đã nộp</span>
                                }
                                else
                                {
                                    <span class="status-badge bg-light text-muted border"><i class="fa-solid fa-lock-open"></i> Chưa làm</span>
                                }
                            </div>
                            <div class="p-4 flex-grow-1 d-flex flex-column justify-content-between">
                                <div>
                                    <h3 class="text-primary mt-0 mb-2">@problem.Title</h3>
                                    <div class="d-flex gap-2 mb-3">
                                        <span class="badge bg-info text-dark">Độ khó: @problem.Difficulty</span>
                                        <span class="badge bg-warning text-dark">Giá trị: @problem.Points điểm</span>
                                    </div>
                                    <p class="text-muted">Đọc đề bài và viết code để mở khóa kho báu điểm nhé!</p>
                                </div>
                                <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                                    @if (hasSub)
                                    {
                                        <div>
                                            <span class="text-muted text-xs">Điểm đạt được:</span>
                                            <strong class="d-block text-success fs-5">Đạt @score / @problem.Points điểm</strong>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted text-xs">Chưa có điểm</span>
                                    }

                                    @if (DateTime.UtcNow > Model.EndTime)
                                    {
                                        <a asp-action="Problem" asp-route-id="@problem.Id" class="btn-kids btn-secondary-kids wiggle-hover">
                                            Xem Chi Tiết <i class="fa-solid fa-chevron-right"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="Problem" asp-route-id="@problem.Id" class="btn-kids btn-secondary-kids wiggle-hover">
                                            Thử Sức Ngay <i class="fa-solid fa-chevron-right"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    questNum++;
                }
            }
        </div>
    </div>
</div>
