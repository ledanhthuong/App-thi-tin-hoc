@using App_thi_tin_hoc.Models
@using App_thi_tin_hoc.Controllers
@{
    var contest = ViewBag.Contest as Contest;
    ViewData["Title"] = "Bảng Xếp Hạng - " + contest?.Title;
    var leaderboardData = Model as List<ContestRankRow> ?? new List<ContestRankRow>();
}

<div class="row">
    <div class="col-lg-9 mx-auto">
        <!-- Header -->
        <div class="card-kids p-4 mb-4" style="background: linear-gradient(135deg, hsl(252, 90%, 97%), hsl(200, 95%, 97%)); border-color: var(--color-primary);">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <a asp-action="Detail" asp-route-id="@contest?.Id" class="btn-kids btn-secondary-kids" style="padding: 6px 16px; font-size: 0.95rem;">
                    <i class="fa-solid fa-arrow-left"></i> Quay lại Cuộc Thi
                </a>
                <span class="badge bg-warning text-dark p-2"><i class="fa-solid fa-ranking-star"></i> Xếp hạng thời gian thực</span>
            </div>
            <h1 class="text-primary mt-2">Bảng Vàng Thi Đấu</h1>
            <p class="text-muted mb-0">Xếp hạng của tất cả học sinh trong cuộc thi <strong>@contest?.Title</strong>.</p>

            @if (ViewBag.Sessions != null && (ViewBag.Sessions as List<string>)?.Count > 0)
            {
                <div class="mt-3 d-flex align-items-center gap-2">
                    <label for="sessionSelect" class="text-dark fw-bold mb-0" style="white-space: nowrap;"><i class="fa-solid fa-calendar-days"></i> Chọn đợt thi:</label>
                    <select id="sessionSelect" class="form-select" style="width: auto; max-width: 320px; border: 2px solid var(--color-primary); border-radius: var(--border-radius-md); font-family: 'Fredoka', 'Nunito', sans-serif;" onchange="changeSession()">
                        @foreach (var s in ViewBag.Sessions as List<string>)
                        {
                            if (s == ViewBag.SelectedSession as string)
                            {
                                <option value="@s" selected>@s</option>
                            }
                            else
                            {
                                <option value="@s">@s</option>
                            }
                        }
                    </select>
                </div>
            }
        </div>

        <!-- Leaderboard list -->
        <div class="card-kids p-4">
            @if (!leaderboardData.Any())
            {
                <div class="text-center py-5">
                    <p class="text-muted fs-5">Chưa có học sinh nào nộp bài giải trong cuộc thi này.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr class="table-light">
                                <th style="width: 80px;">Hạng</th>
                                <th style="width: 60px;">Hình</th>
                                <th>Học Sinh</th>
                                <th>Danh hiệu</th>
                                <th class="text-center">Điểm Cuộc Thi</th>
                                <th class="text-center">Tổng Điểm Tích Lũy</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rank = 1;
                                @foreach (var row in leaderboardData)
                                {
                                    var rankClass = rank == 1 ? "rank-1" : rank == 2 ? "rank-2" : rank == 3 ? "rank-3" : "rank-other";
                                    var rowHighlight = rank <= 3 ? "table-light fw-bold" : "";

                                    <tr class="@rowHighlight">
                                        <td>
                                            <span class="rank-badge @rankClass">@rank</span>
                                        </td>
                                        <td>
                                            <img src="@row.AvatarUrl" alt="Avatar" class="rounded-circle border border-2 border-primary" style="width: 42px; height: 42px; object-fit: cover;" />
                                        </td>
                                        <td>
                                            <div class="fw-bold">@row.FullName</div>
                                        </td>
                                        <td>
                                            <small class="text-muted">@row.RankTitle</small>
                                        </td>
                                        <td class="text-center">
                                            <span class="text-success fs-5 fw-bold">@row.ContestScore</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="text-primary fw-bold">@row.Points</span> <span class="text-muted small">điểm</span>
                                        </td>
                                    </tr>
                                    rank++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function changeSession() {
            var selectedSession = document.getElementById("sessionSelect").value;
            window.location.href = "?contestId=@contest?.Id&session=" + encodeURIComponent(selectedSession);
        }
    </script>
}
